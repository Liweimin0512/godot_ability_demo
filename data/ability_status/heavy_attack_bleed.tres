[gd_resource type="Resource" script_class="GameplayStatusData" format=3]

[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/status/gameplay_status_data.gd" id="1_status"]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/status/features/status_feature.gd" id="2_feature"]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/status/features/feature_periodic_effects.gd" id="3_periodic"]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/effects/gameplay_effect.gd" id="4_effect"]
[ext_resource type="Script" path="res://addons/gameplay_abiltiy_system/scripts/effects/ge_modify_vital.gd" id="5_vital"]

[sub_resource type="Resource" id="Resource_bleed_damage"]
script = ExtResource("5_vital")
