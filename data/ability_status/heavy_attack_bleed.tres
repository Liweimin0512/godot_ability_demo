amount = -3.0

[sub_resource type="Resource" id="Resource_bleed_periodic"]
script = ExtResource("3_periodic")
period = 1.0
periodic_effects = Array[ExtResource("4_effect")]([SubResource("Resource_bleed_damage")])

[resource]
script = ExtResource("1_status")
