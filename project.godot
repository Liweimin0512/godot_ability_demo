; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="godot_ability_demo"
run/main_scene="uid://30orglekea3b"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameplayAbilitySystem="*uid://u2lf4qtnkmft"
DamageCalculator="*uid://b2jxgcjagrkdx"
TagManager="*uid://crdi6238nttlg"
AbilityEventBus="*uid://dly4cms3ynkwf"
GameplayCueManager="*uid://b4t83autfu2j7"
Panku="*res://addons/panku_console/console.tscn"
ConsoleCommands="*res://scripts/singletons/console_commands.gd"
DebugDraw="*res://addons/zylann.debug_draw/debug_draw.gd"
TalentSystem="*res://scripts/talent/talent_system.gd"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=960
window/size/window_height_override=540
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/gameplay_abiltiy_system/plugin.cfg", "res://addons/panku_console/plugin.cfg", "res://addons/simple_inventory/plugin.cfg")

[global_group]

